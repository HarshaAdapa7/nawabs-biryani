# GOOGLE_MAPS_API_KEY: Server-side only key for Google Places API (New).
# Never prefix with VITE_ or NEXT_PUBLIC_ so it remains strictly on the server.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_PLACES_API_KEY"

